# Configuración General del Entorno
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-rag-industrial-2026-change-in-prod

# Base de Datos Relacional PostgreSQL (SQLAlchemy + Psycopg 3)
DATABASE_URL=postgresql+psycopg://flaskuser:Flask2026_db@localhost:5432/flask_db

# Rutas de Almacenamiento Local Seguro
UPLOAD_FOLDER=storage/uploads
CHROMA_PERSIST_DIRECTORY=storage/chroma
MAX_CONTENT_LENGTH=52428800

# Servicio Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.1:8b

# Configuración CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
